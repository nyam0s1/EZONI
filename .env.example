# Vercel's Neon integration provides DATABASE_URL automatically.
DATABASE_URL=postgresql://username:password@your-neon-host/database?sslmode=verify-full
# Optional absolute path to a trusted CA certificate bundle.
# DB_SSL_CA=/path/to/trusted-ca-bundle.pem

# Alternative: existing MySQL-compatible server (omit DATABASE_URL).
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_NAME=your-database-name
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DB_SSL_REQUIRED=true
